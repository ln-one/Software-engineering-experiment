@startuml

top to bottom direction
skinparam defaultFontName SimHei
skinparam defaultFontSize 10
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 30

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
}

skinparam package {
    BackgroundColor #F0F0F0
    BorderColor #333333
}

title 系统组成和接口关系图

package "智慧城市综合交通管理与服务平台" {
    together {
        rectangle "用户管理" as M1
        rectangle "交通数据管理" as M2
        rectangle "设备管理" as M3
        rectangle "信息发布" as M4
        rectangle "工单管理" as M5
        rectangle "支付管理" as M6
    }
    together {
        rectangle "系统日志" as M7
        rectangle "报表统计" as M8
        rectangle "系统配置" as M9
        rectangle "系统监控" as M10
    }
}

together {
    rectangle "城市交通信号控制系统" as E1
    rectangle "公安交管综合应用平台" as E2
    rectangle "城市应急指挥系统" as E3
    rectangle "智慧停车管理系统" as E4
    rectangle "公共交通调度系统" as E5
}

M2 -down-> E1 : 流量数据
M3 -down-> E1 : 设备控制
M2 -down-> E2 : 违章数据
M4 -down-> E3 : 事件上报
M6 -down-> E4 : 费用结算
M2 -down-> E5 : 公交数据

@enduml